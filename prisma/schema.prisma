generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id             String          @id @default(cuid())
  name_en        String
  name_ar        String          @default("")
  slug           String          @unique
  description_en String          @db.Text
  description_ar String          @default("") @db.Text
  price          Float
  stock          Int             @default(0)   // Used when hasVariants = false
  imageUrl       String                        // Primary / cover image
  gallery        String[]        @default([])  // Additional gallery images
  hasVariants    Boolean         @default(false)
  category       String          @default("LIPSTICK")
  brand          String?
  tags           String[]        @default([])
  benefits       String?         @db.Text
  ingredients    String?         @db.Text
  usage          String?         @db.Text
  isBestseller   Boolean         @default(false)
  isOffer        Boolean         @default(false)
  salePrice      Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  coverVariantId String?                        // Which shade is the product's cover image/default — null = use variants[0]
  coverVariant   Variant?        @relation("ProductCover", fields: [coverVariantId], references: [id], onDelete: SetNull)
  variants       Variant[]       @relation("ProductVariants")
  orderItems     OrderItem[]

  @@index([slug])
  @@index([category])
  @@index([brand])
  @@index([coverVariantId])
}

// ─── Variants (shades / tones) ───────────────────────────────────────────────

model Variant {
  id          String      @id @default(cuid())
  productId   String
  shadeName   String      // e.g. "Rose Nude", "Ruby Red"
  hexColor    String      // e.g. "#D4847A"
  colorSource String      @default("manual") // "manual" | "suggested" — never overwrite "manual" without explicit re-suggest
  image       String?     // Variant-specific image (optional)
  stock       Int         @default(0)
  sku         String?
  sortOrder   Int         @default(0)

  product        Product     @relation("ProductVariants", fields: [productId], references: [id], onDelete: Cascade)
  coverOfProduct Product[]   @relation("ProductCover")
  orderItems     OrderItem[]

  @@index([productId])
}

// ─── Categories (admin-managed table) ────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String                       // English label
  name_ar     String   @default("")        // Arabic label — "" means not yet translated, falls back to `name`
  slug        String   @unique             // Matches Product.category values — not a hard FK, see note on Product below
  description String?
  image       String?                      // Cloudinary URL, optional
  isActive    Boolean  @default(true)       // Inactive = hidden from public filters/forms, but existing products keep working
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerPhone   String
  customerAddress String      @default("")
  deliveryType    String      @default("home")
  totalPrice      Float
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  idempotencyKey  String?     @unique // client-generated token; prevents duplicate orders from retries/double-submit

  @@index([customerPhone])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  variantName String?  // Shade name snapshot for admin reference
  quantity    Int
  price       Float
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// ─── Customers ───────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  totalOrders Int      @default(0)
  createdAt   DateTime @default(now())
  orders      Order[]
}

// ─── Admin Users ─────────────────────────────────────────────────────────────

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  role           String    @default("ADMIN")
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
}

// ─── Testimonials ─────────────────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  text      String   @db.Text
  name      String
  role      String                       // e.g. "Verified Buyer · Dubai"
  stars     Int      @default(5)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Store settings (simple key/value — WhatsApp number, etc.) ──────────────
// A plain key/value table on purpose: a handful of scattered scalar settings
// don't need a bespoke column each, and this reuses the existing DB instead
// of a new config service. One row per setting, admin-editable.

model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Rate limiting (serverless-safe — backed by the shared DB, not in-memory) ─

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String   // e.g. "track-order:22411234" or "place-order:ip:1.2.3.4"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  DELIVERED
  CANCELLED
}

